{
  "name": "infinite-ball-roll",
  "version": "1.0.0",
  "private": true,
  "description": "Infinite ball rolling game for iOS and Android (Temple Run-style endless runner)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node test/sim.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:gen": "node scripts/gen-assets.mjs",
    "assets:native": "capacitor-assets generate",
    "preview": "vite preview --host",
    "cap:sync": "npm run build && cap sync",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "cap:android": "npm run build && cap sync android && cap open android"
  },
  "keywords": [
    "game",
    "endless-runner",
    "threejs",
    "capacitor",
    "ios",
    "android"
  ],
  "license": "MIT",
  "dependencies": {
    "@capacitor/app": "^5.0.7",
    "@capacitor/preferences": "^5.0.7",
    "@capacitor/splash-screen": "^5.0.7",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^5.7.0",
    "@capacitor/core": "^5.7.0",
    "@capacitor/android": "^5.7.0",
    "@capacitor/ios": "^5.7.0",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.2.0",
    "vite": "^5.0.0"
  }
}
