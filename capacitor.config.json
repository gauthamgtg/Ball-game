{
  "appId": "com.bizeract.infiniteballroll",
  "appName": "Infinite Ball Roll",
  "webDir": "dist",
  "backgroundColor": "#0b1026",
  "android": {
    "backgroundColor": "#0b1026"
  },
  "ios": {
    "backgroundColor": "#0b1026",
    "contentInset": "always"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#0b1026",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
